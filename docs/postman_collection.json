{
  "info": {
    "name": "N703 - API Climática e Geográfica",
    "description": "Coleção de testes para a API de dados climáticos e geográficos desenvolvida na disciplina Técnicas de Integração de Sistemas (N703) - Unifor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /api/v1/health - Serviço saudável",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/health",
            "description": "Verifica se a API está funcionando corretamente. Retorna HTTP 200 com status healthy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status é healthy', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('healthy');",
                  "    pm.expect(json).to.have.property('versao');",
                  "    pm.expect(json).to.have.property('timestamp');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Clima",
      "item": [
        {
          "name": "GET /clima/Fortaleza - Sucesso 200",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/clima/Fortaleza",
            "description": "Retorna dados climáticos e geográficos de Fortaleza/CE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Campos obrigatórios presentes', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('nome');",
                  "    pm.expect(json).to.have.property('estado');",
                  "    pm.expect(json).to.have.property('clima');",
                  "    pm.expect(json).to.have.property('consultado_em');",
                  "});",
                  "pm.test('Objeto clima tem campos corretos', () => {",
                  "    const clima = pm.response.json().clima;",
                  "    pm.expect(clima).to.have.property('temperatura_min');",
                  "    pm.expect(clima).to.have.property('temperatura_max');",
                  "    pm.expect(clima).to.have.property('condicao');",
                  "    pm.expect(clima).to.have.property('unidades');",
                  "});",
                  "pm.test('Cidade e estado corretos', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.nome).to.eql('Fortaleza');",
                  "    pm.expect(json.estado).to.eql('CE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /clima/São Paulo - Sucesso 200",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/clima/S%C3%A3o%20Paulo",
            "description": "Retorna dados climáticos de São Paulo/SP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Estado é SP', () => {",
                  "    pm.expect(pm.response.json().estado).to.eql('SP');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /clima/X - Erro 400 (nome inválido)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/clima/X",
            "description": "Deve retornar HTTP 400 pois o nome tem menos de 2 caracteres."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Código NOME_INVALIDO', () => {",
                  "    pm.expect(pm.response.json().detail.codigo).to.eql('NOME_INVALIDO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /clima/CidadeFalsa999 - Erro 404 (não encontrada)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/clima/CidadeFalsa999",
            "description": "Deve retornar HTTP 404 pois a cidade não existe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Código CIDADE_NAO_ENCONTRADA', () => {",
                  "    pm.expect(pm.response.json().detail.codigo).to.eql('CIDADE_NAO_ENCONTRADA');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cidades por Estado",
      "item": [
        {
          "name": "GET /cidades/CE - Sucesso 200",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/cidades/CE",
            "description": "Retorna lista de cidades do Ceará com limite padrão (10)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Campos obrigatórios presentes', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('uf');",
                  "    pm.expect(json).to.have.property('quantidade_retornada');",
                  "    pm.expect(json).to.have.property('cidades');",
                  "    pm.expect(json.cidades).to.be.an('array');",
                  "});",
                  "pm.test('UF é CE', () => {",
                  "    pm.expect(pm.response.json().uf).to.eql('CE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /cidades/CE?limite=5 - Com limite",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/cidades/CE?limite=5",
              "query": [{ "key": "limite", "value": "5" }]
            },
            "description": "Retorna apenas 5 cidades do Ceará."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Quantidade limitada a 5', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.quantidade_retornada).to.eql(5);",
                  "    pm.expect(json.cidades.length).to.eql(5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /cidades/ceara - Erro 400 (sigla inválida)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/cidades/ceara",
            "description": "Deve retornar HTTP 400 pois a sigla deve ter exatamente 2 letras."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Código SIGLA_UF_INVALIDA', () => {",
                  "    pm.expect(pm.response.json().detail.codigo).to.eql('SIGLA_UF_INVALIDA');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /cidades/XX - Erro 404 (estado não encontrado)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/cidades/XX",
            "description": "Deve retornar HTTP 404 pois XX não é uma sigla de estado válida."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Código UF_NAO_ENCONTRADA', () => {",
                  "    pm.expect(pm.response.json().detail.codigo).to.eql('UF_NAO_ENCONTRADA');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}